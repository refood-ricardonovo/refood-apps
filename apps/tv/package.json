{
	"name": "tv",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"deploy": "node -e \"console.error('Sem ambiente nao ha deploy. Usa: npm run deploy:staging --workspace=tv  ou  npm run deploy:producao --workspace=tv'); process.exit(1)\"",
		"deploy:staging": "wrangler deploy --env staging",
		"deploy:producao": "wrangler deploy",
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"cf-typegen": "wrangler types",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@types/node": "^26.4.0",
		"typescript": "^5.5.2",
		"wrangler": "^4.127.1",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"@refood/odoo": "*"
	}
}
