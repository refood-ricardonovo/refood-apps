{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "refood-tv",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-25",
  "assets": {
    "directory": "./public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "refood-db",
      "database_id": "1756a0f6-9464-4257-a6ac-7fee8118dc70",
      "preview_database_id": "48465336-f8d0-45f3-beef-b7149c1d4a8a"
    }
  ],
  "vars": {
    "ODOO_URL": "https://staging.onrefood.com",
    "ODOO_DB": "refoodteste"
  },
  "observability": { "enabled": true },
  "upload_source_maps": true
}