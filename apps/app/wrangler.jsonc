{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "refood-app",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-25",
	"assets": {
		"directory": "./public",
		// **Sem `not_found_handling`, e é de propósito.** O valor por omissão deixa um pedido que não
		// corresponda a ficheiro nenhum cair no Worker, que é o que permite existir `/api/*`. Pôr
		// `single-page-application` faria o servidor de assets responder `index.html` a tudo — e o
		// Worker deixava de correr, `/api/health` incluído. Se um dia a página precisar de rotas do
		// lado do cliente, o que isso pede é `run_worker_first` para `/api/*`, não este atalho.
	},
	// A base é partilhada com o `apps/tv` e o `d1_migrations` é um livro-razão único, por isso as
	// migrações vivem em `migrations/` na raiz do monorepo. Ver o CLAUDE.md da raiz.
	//
	// `migrations_dir` é relativo a este ficheiro, e **repete-se no `env.staging`** porque
	// `d1_databases` é chave não-herdável: o array é substituído inteiro, nunca fundido. Uma entrada
	// sem ele cai num `./migrations` que aqui não existe, e o wrangler diz que não há nada a aplicar.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "refood-db",
			"database_id": "1756a0f6-9464-4257-a6ac-7fee8118dc70",
			"preview_database_id": "48465336-f8d0-45f3-beef-b7149c1d4a8a",
			"migrations_dir": "../../migrations",
		},
	],
	// `vars` são valores públicos, cozidos nos tipos gerados. As credenciais do Odoo e o interruptor
	// da entrada são secrets — ver `.dev.vars.example`.
	"vars": {
		"ODOO_URL": "https://staging.onrefood.com",
		"ODOO_DB": "refoodteste",
	},
	"observability": { "enabled": true },
	"upload_source_maps": true,
	// Os dois ambientes. O `routes` vive dentro de cada um e não no topo, apesar de ser chave
	// herdável: no topo um só padrão passava a valer para os dois, e aqui cada ambiente tem o seu
	// endereço — `app-staging.myrefood.pt` em staging, o apex `myrefood.pt` em produção. É a mesma
	// decisão que está no `wrangler.jsonc` da TV, onde produção continua sem domínio.
	//
	// As chaves não-herdáveis — `d1_databases` e `vars` — têm de ser repetidas aqui.
	"env": {
		"staging": {
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "refood-db-staging",
					"database_id": "48465336-f8d0-45f3-beef-b7149c1d4a8a",
					"migrations_dir": "../../migrations",
				},
			],
			"vars": {
				"ODOO_URL": "https://staging.onrefood.com",
				"ODOO_DB": "refoodteste",
			},
			// `custom_domain: true` faz o wrangler criar o registo de DNS e o certificado no deploy.
			// A zona `myrefood.pt` já está na conta — é a mesma de `tv-staging.myrefood.pt`.
			"routes": [
				{
					"pattern": "app-staging.myrefood.pt",
					"custom_domain": true,
				},
			],
		},
		// Produção. Existe como ambiente com nome porque o `deploy:producao` o endereça — e porque
		// **não há `deploy` solto**: um deploy sem `--env` empurrava a config do topo, que não tem
		// rotas, para cima do worker de produção.
		//
		// A base é a `refood-db`, uuid `1756a0f6…`. Correr sempre o `migrations list` antes de
		// qualquer `apply` e ler o uuid que ele imprime: o de staging é o `48465336…`.
		"production": {
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "refood-db",
					"database_id": "1756a0f6-9464-4257-a6ac-7fee8118dc70",
					"migrations_dir": "../../migrations",
				},
			],
			// **O Odoo de produção, e é de propósito** — não o de staging. A sala são voluntários
			// reais, e uma base desactualizada transformava o "ainda não te encontrámos" num terço
			// das pessoas presentes. As credenciais continuam a ser secrets, nunca aqui.
			//
			// **A base chama-se `refood.flybyodoo.pt`** — o nome tem pontos e parece um domínio, e não
			// é o `refood` que se adivinha a partir do URL. Adivinhá-lo custou uma noite: um nome de
			// base errado **não dá erro** neste servidor, o `common.authenticate` devolve `false` — o
			// mesmo que uma password errada. Não se distingue uma coisa da outra pela resposta.
			"vars": {
				"ODOO_URL": "https://erp.onrefood.com",
				"ODOO_DB": "refood.flybyodoo.pt",
			},
			// O apex, com `custom_domain` e não com `zone_name`, e a razão é o estado da zona:
			// **o apex está vazio** — o `myrefood.pt` tem um único registo, o `tv-staging` —, portanto
			// não há nada com que colidir e o wrangler pode criar o registo e o certificado no deploy.
			// A escolha não é de gosto: `custom_domain: true` **falha** se já existir registo no apex,
			// e `zone_name` exige que ele já exista, proxied. Se alguém puser um `A` ou um `CNAME` no
			// apex antes do primeiro deploy, é este bloco que passa a ter de mudar de forma.
			//
			// Com `routes` na configuração, o endereço `workers.dev` fica desligado — mesma coisa que
			// na TV.
			"routes": [
				{
					"pattern": "myrefood.pt",
					"custom_domain": true,
				},
			],
		},
	},
}
