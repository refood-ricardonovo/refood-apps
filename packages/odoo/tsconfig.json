{
	"compilerOptions": {
		"target": "es2024",
		"lib": [
			"es2024",
			"dom"
		],
		"module": "es2022",
		"moduleResolution": "node",
		"noEmit": true,
		"isolatedModules": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"skipLibCheck": true,
		"types": []
	},
	"include": [
		"src",
		"test",
		"vitest.config.ts"
	]
}
